# ===== 运行时 / 环境（绝不上传）=====
.runtime/
.runtime-asar-files.json
.devhome/
.poc/
.pnpm-store/
.dsh-poc/
.tmp-api-test-*/

# 测试探针每次重建的仓库副本（probes/governance-e2e.mjs 会 rm -rf 后重灌）
.sandbox/
# native 扩展缓存产物（含 .node 二进制），来自 DSH 运行时的 undefined 路径
undefined/
# 本仓库自身被插件初始化出的运行时目录（仅根目录；不影响插件对 .project 的语义）
/.project/

# ===== 凭据与本地备份（绝不上传）=====
.artifacts/
*.credentials.yaml
.env
.env.*

# ===== 依赖与构建产物 =====
node_modules/
dist/
*.tgz

# ===== 测试运行产物（测试源码保留）=====
workbench/tests/e2e/.artifacts/
.tmp-*/
**/.tmp-*/
*.log

# ===== 临时脚本与探针 =====
scripts-tmp/
*.tmp

# ===== 数据库运行文件 =====
*.db-shm
*.db-wal

# ===== 系统文件 / Windows 保留设备名 =====
/CON
/PRN
/AUX
/NUL
/COM[0-9]
/LPT[0-9]
Thumbs.db
Desktop.ini
.DS_Store
